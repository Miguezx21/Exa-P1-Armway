                        <path d="M 135 320 C 125 260, 170 215, 235 195 C 295 165, 380 75, 470 15 C 540 0, 600 50, 601 130 C 602 185, 575 225, 535 255 C 490 290, 495 360, 480 440 C 465 510, 430 550, 360 558 C 290 560, 230 520, 215 460 C 195 405, 150 365, 135 320 Z" fill="#E5FDFF" />
                    </svg>-->
                </div>

                <h2 class="section-title">Become A Creator</h2>

                <div class="creator-grid">
                    <div class="creator-card">
