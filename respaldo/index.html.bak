<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Amway</title>
    <!-- Iconos de FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="styles.css">
</head>
<body>

    <header class="site-header">
        <!-- 1. BARRA SUPERIOR (Top Bar) -->
        <div class="top-bar">
            <nav class="top-nav-left">
                <a href="#">Start a Business</a>
                <a href="#">Shop with a Business Owner</a>
                <a href="#">Our Story</a>
            </nav>

            <div class="top-nav-right">
                <!-- Selector de Idioma -->
                <select id="language" name="language">
                    <option value="English">English</option>
                    <option value="Spanish">Spanish</option>
                    <option value="French">French</optionth>
                </select>

                <!-- Selector de Ayuda -->
                <select id="help" name="help">
                    <option value="Help">Help</option>
                    <option value="Contact">Contact us</option>
                </select>

                <!-- Menú de Usuario con Icono SVG -->
                <div class="user-dropdown">
                    <svg class="user-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    <select id="user-menu" name="user-menu">
                        <option value="user">Hi Gregory</option>
                        <option value="logout">Log out</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- 2. BARRA PRINCIPAL (Main Header) -->
        <div class="main-header">
            <div class="logo">
                <a href="#"><img src="https://images.seeklogo.com/logo-png/21/2/amway-logo-png_seeklogo-213034.png" alt="Amway Logo"></a>
            </div>

            <nav class="main-nav">
                <a href="#">SHOP PRODUCTS <i class="fa-solid fa-chevron-down"></i></a>
                <a href="#">SHOP BRANDS <i class="fa-solid fa-chevron-down"></i></a>
                <a href="#">AMPERKS <i class="fa-solid fa-chevron-down"></i></a>
            </nav>

            <div class="header-actions">
                <div class="search-box">
                    <input type="text" placeholder="Search">
                    <button type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>
                <a href="#" class="cart-icon">
                    <i class="fa-solid fa-cart-shopping"></i>
                </a>
            </div>
        </div>
    </header>

    <main>
        <section class="hero-section">
            <div class="hero-content">
                <h1>Grow Your Business With Social</h1>
                <p>Start building a community of customers and turning your passions into profit today. Learn how to sell socially with Amway Creators.</p>
                <div class="hero-buttons">
                    <button class="Get-Started">Get Started</button>
                    <a href="#" class="Watch-Video">Watch a Video</a>
                </div>
            </div>
            <div class="hero-image">
                <img src="imagenes/S1.png" alt="Hero Image">
            </div>
        </section>

        <section class="features-section">
            <div class="feature">
                <img src="imagenes/connected.png" alt="Connected">
                <h3>Get Connected</h3>
                <p>Protect your social accounts.</p>
            </div>
            <div class="feature">
                <img src="imagenes/edu.png" alt="Education">
                <h3>Get Educated</h3>
                <p>Know the rules.</p>
            </div>
            <div class="feature">
                <img src="imagenes/inspired.png" alt="Inspired">
                <h3>Get Inspired</h3>
                <p>Create Content.</p>
            </div>
            <div class="feature">
                <img src="imagenes/custome.png" alt="Custome">
                <h3>Get Customers</h3>
                <p>Tools to get your earning.</p>
            </div>
        </section> 

        <section class="become-creator-section">
            <div class="creator-container">
