@charset "UTF-8";
* {
  margin: 0;
  padding: 0;
  box-sizing: border-border-box;
}

body {
  font-family: "Arial", sans-serif;
  color: #333333;
  line-height: 1.6;
  background-color: #ffffff;
}

a {
  text-decoration: none;
  color: inherit;
}

.site-header {
  border-bottom: 1px solid #e0e0e0;
}
.site-header .top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 40px;
  background-color: #ffffff;
  font-size: 13px;
  border-bottom: 1px solid #e0e0e0;
}
.site-header .top-bar .top-nav-left {
  display: flex;
  gap: 20px;
}
.site-header .top-bar .top-nav-left a {
  color: #666666;
}
.site-header .top-bar .top-nav-left a:hover {
  color: #2b4c7e;
}
.site-header .top-bar .top-nav-right {
  display: flex;
  align-items: center;
  gap: 15px;
}
.site-header .top-bar .top-nav-right select {
  border: none;
  background: transparent;
  color: #666666;
  cursor: pointer;
  outline: none;
}
.site-header .top-bar .top-nav-right .user-dropdown {
  display: flex;
  align-items: center;
  gap: 5px;
}
.site-header .top-bar .top-nav-right .user-dropdown .user-icon {
  stroke: #666666;
}
.site-header .main-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 40px;
}
.site-header .main-header .logo img {
  height: 35px;
}
.site-header .main-header .main-nav {
  display: flex;
  gap: 30px;
}
.site-header .main-header .main-nav a {
  font-weight: bold;
  font-size: 14px;
  color: #333333;
  display: flex;
  align-items: center;
  gap: 6px;
}
.site-header .main-header .main-nav a i {
  font-size: 11px;
}
.site-header .main-header .main-nav a:hover {
  color: #2b4c7e;
}
.site-header .main-header .header-actions {
  display: flex;
  align-items: center;
  gap: 20px;
}
.site-header .main-header .header-actions .search-box {
  display: flex;
  align-items: center;
  border: 1px solid #e0e0e0;
  border-radius: 20px;
  padding: 6px 12px;
}
.site-header .main-header .header-actions .search-box input {
  border: none;
  outline: none;
  padding: 4px;
  font-size: 14px;
}
.site-header .main-header .header-actions .search-box button {
  background: transparent;
  border: none;
  cursor: pointer;
  color: #666666;
}
.site-header .main-header .header-actions .cart-icon {
  font-size: 18px;
  color: #333333;
}

.hero-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60px 80px;
  background-color: #eaf3fa;
}
.hero-section .hero-content {
  max-width: 500px;
}
.hero-section .hero-content h1 {
  font-size: 42px;
  color: #2b4c7e;
  line-height: 1.2;
  margin-bottom: 20px;
}
.hero-section .hero-content p {
  font-size: 16px;
  color: #666666;
  margin-bottom: 30px;
}
.hero-section .hero-content .Get-Started {
  background-color: #2b4c7e;
  color: #ffffff;
  border: none;
  padding: 12px 28px;
  border-radius: 25px;
  font-weight: bold;
  cursor: pointer;
  margin-right: 15px;
}
.hero-section .hero-content .Get-Started:hover {
  opacity: 0.9;
}
.hero-section .hero-content .Watch-Video {
  color: #2b4c7e;
  font-weight: bold;
}
.hero-section .hero-content .Watch-Video:hover {
  text-decoration: underline;
}
.hero-section .hero-image img {
  max-width: 450px;
  width: 100%;
  height: auto;
}

.features-section {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
  padding: 60px 80px;
  text-align: center;
}
.features-section .feature img {
  width: 70px;
  height: 70px;
  margin-bottom: 15px;
}
.features-section .feature h3 {
  font-size: 18px;
  margin-bottom: 8px;
  color: #333333;
}
.features-section .feature p {
  font-size: 14px;
  color: #666666;
}

.become-creator-section {
  padding: 60px 80px;
  text-align: center;
}
.become-creator-section .section-title {
  font-size: 32px;
  color: #333333;
  margin-bottom: 40px;
}
.become-creator-section .creator-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 50px;
  max-width: 900px;
  margin: 0 auto;
}
.become-creator-section .creator-grid .creator-card {
  text-align: left;
}
.become-creator-section .creator-grid .creator-card img {
  width: 180px;
  height: 180px;
  border-radius: 50%;
  -o-object-fit: cover;
     object-fit: cover;
  margin-bottom: 15px;
}
.become-creator-section .creator-grid .creator-card h3 {
  font-size: 20px;
  margin-bottom: 10px;
  color: #333333;
}
.become-creator-section .creator-grid .creator-card p {
  font-size: 14px;
  color: #666666;
  line-height: 1.5;
}

.cta-section {
  background-color: #eaf3fa;
  padding: 50px 20px;
  text-align: center;
  border-radius: 10px;
  margin: 40px 80px;
}
.cta-section h2 {
  font-size: 28px;
  color: #2b4c7e;
  margin-bottom: 10px;
}
.cta-section p {
  color: #666666;
  margin-bottom: 20px;
}
.cta-section .Get-Started {
  background-color: #2b4c7e;
  color: #ffffff;
  border: none;
  padding: 12px 30px;
  border-radius: 25px;
  font-weight: bold;
  cursor: pointer;
}

.faq-section {
  max-width: 800px;
  margin: 40px auto 80px;
  padding: 0 20px;
}
.faq-section .faq-item {
  border-bottom: 1px solid #e0e0e0;
  padding: 15px 0;
}
.faq-section .faq-item summary {
  font-size: 18px;
  font-weight: bold;
  cursor: pointer;
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.faq-section .faq-item summary::-webkit-details-marker {
  display: none;
}
.faq-section .faq-item summary::after {
  content: "❯";
  transform: rotate(90deg);
  font-size: 14px;
  transition: transform 0.2s ease;
}
.faq-section .faq-item[open] summary::after {
  transform: rotate(-90deg);
}
.faq-section .faq-item p {
  margin-top: 10px;
  color: #666666;
  font-size: 14px;
}

.site-footer {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid #e0e0e0;
  background-color: #fafafa;
}
.site-footer .footer-card {
  padding: 40px;
  text-align: center;
  border-right: 1px solid #e0e0e0;
}
.site-footer .footer-card:last-child {
  border-right: none;
}
.site-footer .footer-card i {
  font-size: 30px;
  color: #2b4c7e;
  margin-bottom: 15px;
}
.site-footer .footer-card h3 {
  font-size: 16px;
  margin-bottom: 10px;
  text-transform: uppercase;
}
.site-footer .footer-card p {
  font-size: 13px;
  color: #666666;
  margin-bottom: 15px;
}
.site-footer .footer-card a {
  color: #2b4c7e;
  font-weight: bold;
  font-size: 14px;
}/*# sourceMappingURL=styles.css.map */