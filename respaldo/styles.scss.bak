// 1. Variables de Diseño (Colores y Fuentes)
$font-family: 'Arial', sans-serif;
$primary-color: #2b4c7e;      // Azul Amway principal
$secondary-color: #eaf3fa;    // Fondo suave del hero y secciones
$text-color: #333333;         // Texto oscuro
$text-light: #666666;         // Texto secundario
$white: #ffffff;
$border-color: #e0e0e0;

// 2. Reseteo y Estilos Base
* {
    margin: 0;
    padding: 0;
    box-sizing: border-border-box;
}

body {
    font-family: $font-family;
    color: $text-color;
    line-height: 1.6;
    background-color: $white;
}

a {
    text-decoration: none;
    color: inherit;
}

.site-header {
    border-bottom: 1px solid $border-color;

    // Barra Superior
    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 40px;
        background-color: $white;
        font-size: 13px;
        border-bottom: 1px solid $border-color;

        .top-nav-left {
            display: flex;
            gap: 20px;

            a {
                color: $text-light;
                &:hover {
                    color: $primary-color;
                }
            }
        }

        .top-nav-right {
            display: flex;
            align-items: center;
            gap: 15px;

            select {
                border: none;
                background: transparent;
                color: $text-light;
                cursor: pointer;
                outline: none;
            }

            .user-dropdown {
                display: flex;
                align-items: center;
                gap: 5px;

                .user-icon {
                    stroke: $text-light;
                }
            }
        }
    }

    // Barra Principal de Navegación
    .main-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 40px;

        .logo img {
            height: 100%;
        }

        .main-nav {
            display: flex;
            gap: 30px;

            a {
                font-weight: bold;
                font-size: 14px;
                color: $text-color;
                display: flex;
                align-items: center;
                gap: 6px;

                i {
                    font-size: 11px;
                }

                &:hover {
                    color: $primary-color;
                }
            }
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 20px;

            .search-box {
                display: flex;
                align-items: center;
                border: 1px solid $border-color;
                border-radius: 20px;
                padding: 6px 12px;

                input {
                    border: none;
                    outline: none;
                    padding: 4px;
                    font-size: 14px;
                }

                button {
                    background: transparent;
                    border: none;
                    cursor: pointer;
                    color: $text-light;
                }
            }

            .cart-icon {
                font-size: 18px;
                color: $text-color;
            }
        }
    }
}

.hero-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 60px 80px;
    background-color: $secondary-color;

    .hero-content {
        max-width: 500px;

        h1 {
            font-size: 42px;
            color: $primary-color;
            line-height: 1.2;
            margin-bottom: 20px;
        }

        p {
            font-size: 16px;
            color: $text-light;
            margin-bottom: 30px;
        }

        .Get-Started {
            background-color: $primary-color;
            color: $white;
            border: none;
            padding: 12px 28px;
            border-radius: 25px;
            font-weight: bold;
            cursor: pointer;
            margin-right: 15px;

            &:hover {
                opacity: 0.9;
            }
        }

        .Watch-Video {
            color: $primary-color;
            font-weight: bold;

            &:hover {
                text-decoration: underline;
            }
        }
    }

    .hero-image img {
        max-width: 450px;
        width: 100%;
        height: auto;
    }
}

.features-section {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
    padding: 60px 80px;
    text-align: center;

    .feature {
        img {
            width: 70px;
            height: 70px;
            margin-bottom: 15px;
        }

        h3 {
            font-size: 18px;
            margin-bottom: 8px;
            color: $text-color;
        }

        p {
            font-size: 14px;
            color: $text-light;
        }
    }
}

// ==========================================
// SECCIÓN: BECOME A CREATOR (Con SVG al fondo)
// ==========================================
.become-creator-section {
    position: relative; // Vital para contener los elementos absolutos internos
    padding: 80px 40px;
    overflow: hidden;   // Evita que el SVG sobresalga de la sección si es muy grande

    // Contenedor interno general
    .creator-container {
        position: relative;
        max-width: 1200px;
        margin: 0 auto;
        z-index: 1; // Asegura que el contenido esté por encima del SVG
    }

    // 1. Estilos para posicionar el SVG al fondo
    .creator-blob-bg {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%); // Lo centra perfectamente
        width: 100%;
        max-width: 800px; // Ajusta el tamaño máximo de la mancha según necesites
        height: 100%;
        z-index: -1;      // Lo manda estrictamente detrás de los textos y tarjetas
        pointer-events: none; // Evita que interfiera con clics del usuario
        display: flex;
        align-items: center;
        justify-content: center;

        svg {
            width: 100%;
            height: auto;
            opacity: 0.8; // Opcional: baja la opacidad si el color es muy fuerte
        }
    }

    // 2. Título de la sección
    .section-title {
        font-size: 36px;
        color: $text-dark;
        text-align: center;
        margin-bottom: 50px;
        font-weight: 800;
    }

    // 3. Cuadrícula de tarjetas (CSS Grid)
    .creator-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 50px;

        @media (max-width: $breakpoint-tablet) {
            grid-template-columns: 1fr;
            gap: 30px;
        }

        .creator-card {
            text-align: left;
            background: rgba(255, 255, 255, 0.7); // Fondo translúcido opcional para legibilidad
            backdrop-filter: blur(5px);          // Efecto moderno si cruza con el blob
            padding: 20px;
            border-radius: 12px;

            img {
                width: 160px;
                height: 160px;
                border-radius: 50%;
                object-fit: cover;
                margin-bottom: 20px;
            }

            h3 {
                font-size: 20px;
                margin-bottom: 12px;
                color: $text-dark;
                font-weight: 700;
            }

            p {
                font-size: 14px;
                color: $text-light;
                line-height: 1.6;
            }
        }
    }
}


// Banner Call to Action
.cta-section {
    background-color: $secondary-color;
    padding: 50px 20px;
    text-align: center;
    border-radius: 10px;
    margin: 40px 80px;

    h2 {
        font-size: 28px;
        color: $primary-color;
        margin-bottom: 10px;
    }

    p {
        color: $text-light;
        margin-bottom: 20px;
    }

    .Get-Started {
        background-color: $primary-color;
        color: $white;
        border: none;
        padding: 12px 30px;
        border-radius: 25px;
        font-weight: bold;
        cursor: pointer;
    }
}

// FAQ (Desplegables)
.faq-section {
    max-width: 800px;
    margin: 40px auto 80px;
    padding: 0 20px;

    .faq-item {
        border-bottom: 1px solid $border-color;
        padding: 15px 0;

        summary {
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
            list-style: none; // Quita la flecha por defecto
            display: flex;
            justify-content: space-between;
            align-items: center;

            &::-webkit-details-marker {
                display: none; // Quita flecha en Chrome/Safari
            }

            &::after {
                content: '❯';
                transform: rotate(90deg);
                font-size: 14px;
                transition: transform 0.2s ease;
            }
        }

        &[open] summary::after {
            transform: rotate(-90deg); // Rotación de la flecha al abrir
        }

        p {
            margin-top: 10px;
            color: $text-light;
            font-size: 14px;
        }
    }
}

.site-footer {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid $border-color;
    background-color: #fafafa;

    .footer-card {
        padding: 40px;
        text-align: center;
        border-right: 1px solid $border-color;

        &:last-child {
            border-right: none;
        }

        i {
            font-size: 30px;
            color: $primary-color;
            margin-bottom: 15px;
        }

        h3 {
            font-size: 16px;
            margin-bottom: 10px;
            text-transform: uppercase;
        }

        p {
            font-size: 13px;
            color: $text-light;
            margin-bottom: 15px;
        }

        a {
            color: $primary-color;
            font-weight: bold;
            font-size: 14px;
        }
    }
}